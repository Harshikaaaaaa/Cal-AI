{
  "expo": {
    "name": "Cal Ai",
    "slug": "nutrisnap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nutrisnap",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Cal Ai needs camera access to scan food and estimate calories.",
        "NSPhotoLibraryUsageDescription": "Cal Ai needs photo library access to upload food photos for calorie estimation."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cal Ai needs photo access to scan your meals.",
          "cameraPermission": "Cal Ai needs camera access to scan your meals."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cal Ai needs camera access to scan your meals."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
